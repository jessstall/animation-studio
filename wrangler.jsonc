// Cloudflare settings for Animation Studio.
// Secret keys are NOT kept here. Add ANTHROPIC_API_KEY in Cloudflare: Workers & Pages → animation-studio → Settings → Variables and Secrets.
{
  "name": "animation-studio",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
